+describe("mattermost websocket proxy routing", () => {
+  const keys = ["HTTPS_PROXY", "https_proxy", "HTTP_PROXY", "http_proxy", "NO_PROXY", "no_proxy", "ALL_PROXY", "all_proxy"] as const;
+  const saved = Object.fromEntries(keys.map((key) => [key, process.env[key]]));
+  beforeEach(() => {
+    for (const key of keys) delete process.env[key];
+  });
+  afterEach(() => {
+    for (const key of keys) {
+      if (saved[key] === undefined) delete process.env[key];
+      else process.env[key] = saved[key];
+    }
+  });
+
+  it("uses a proxy agent for wss when HTTPS_PROXY is set", () => {
+    process.env.HTTPS_PROXY = "http://oce-mattermost-proxy.openclaw-system.svc:3128";
+    expect(resolveMattermostWebSocketAgent("wss://chat.example.com/api/v4/websocket")).toBeDefined();
+  });
+
+  it("goes direct when no proxy is configured", () => {
+    expect(resolveMattermostWebSocketAgent("wss://chat.example.com/api/v4/websocket")).toBeUndefined();
+  });
+
+  it("goes direct when NO_PROXY covers the host", () => {
+    process.env.HTTPS_PROXY = "http://oce-mattermost-proxy.openclaw-system.svc:3128";
+    process.env.NO_PROXY = "chat.example.com";
+    expect(resolveMattermostWebSocketAgent("wss://chat.example.com/api/v4/websocket")).toBeUndefined();
+  });
+});
